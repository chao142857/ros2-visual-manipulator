* {
    font-family: "DejaVu Sans", "Noto Sans";
    font-size: 10pt;
    color: #d9e1e8;
}

QMainWindow, QWidget {
    background-color: #15191f;
}

QFrame[card="true"] {
    background-color: #1d232b;
    border: 1px solid #303944;
    border-radius: 6px;
}

QTabWidget#moduleTabs::pane {
    border: none;
    background: transparent;
}

QTabBar::tab {
    min-height: 28px;
    padding: 0 12px;
    margin-right: 2px;
    background-color: #1a2027;
    border: 1px solid #303944;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    color: #788797;
    font-size: 8pt;
    font-weight: 600;
}

QTabBar::tab:selected {
    background-color: #1d232b;
    color: #e4ebf0;
}

QTabBar::tab:hover:!selected {
    color: #b5c1cc;
    background-color: #222a32;
}

QLabel {
    background: transparent;
    border: none;
}

QLabel#windowTitle {
    color: #f2f5f7;
    font-size: 17pt;
    font-weight: 600;
}

QLabel#sectionTitle {
    color: #edf2f5;
    font-size: 11pt;
    font-weight: 600;
}

QLabel#subtitleLabel,
QLabel#secondaryText,
QLabel#statusName {
    color: #82909f;
}

QLabel#columnHeading {
    color: #697888;
    font-size: 8pt;
    font-weight: 600;
}

QLabel#jointAxisLabel {
    color: #c8d3dc;
    font-family: "DejaVu Sans Mono";
    font-weight: 600;
}

QLabel#currentValueLabel,
QLabel#statusValue {
    color: #e7edf2;
    font-family: "DejaVu Sans Mono";
}

QLabel#statusValue[attention="true"] {
    color: #ef927e;
    font-weight: 600;
}

QLabel#currentValueLabel[stale="true"] {
    color: #b47f7f;
}

QLabel#headerStatusLabel {
    font-family: "DejaVu Sans Mono";
    font-weight: 600;
}

QLabel#headerStatusLabel[statusState="ready"] { color: #72c99a; }
QLabel#headerStatusLabel[statusState="degraded"] { color: #e2b86b; }
QLabel#headerStatusLabel[statusState="recovering"] { color: #e2b86b; }
QLabel#headerStatusLabel[statusState="feedback_lost"] { color: #ef927e; }
QLabel#headerStatusLabel[statusState="waiting"] { color: #83909d; }

QLabel#statusDot {
    border-radius: 6px;
    background-color: #65717c;
}

QLabel#statusDot[statusState="ready"] { background-color: #53b77e; }
QLabel#statusDot[statusState="degraded"] { background-color: #d3a34e; }
QLabel#statusDot[statusState="recovering"] { background-color: #d3a34e; }
QLabel#statusDot[statusState="feedback_lost"] { background-color: #df6e60; }
QLabel#statusDot[statusState="waiting"] { background-color: #65717c; }

QPushButton {
    min-height: 34px;
    padding: 0 16px;
    background-color: #29323c;
    border: 1px solid #3a4652;
    border-radius: 4px;
    color: #dbe4eb;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #323d48;
    border-color: #536170;
}

QPushButton:pressed {
    background-color: #222a32;
}

QPushButton:disabled {
    background-color: #20262d;
    border-color: #2b333c;
    color: #596572;
}

QPushButton#moveButton {
    background-color: #276b91;
    border-color: #3785b0;
    color: #f4f8fa;
}

QPushButton#moveButton:hover {
    background-color: #2f7da8;
}

QPushButton#gripperApplyButton {
    background-color: #315e72;
    border-color: #467f98;
    color: #eef5f8;
}

QPushButton#gripperApplyButton:hover {
    background-color: #3a7087;
}

QPushButton#secondaryButton {
    background-color: #242c34;
}

QPushButton#modeButton,
QPushButton#liveModeButton {
    min-height: 30px;
    padding: 0 12px;
    background-color: #202831;
}

QPushButton#modeButton:checked {
    background-color: #31586d;
    border-color: #4c86a3;
    color: #eff7fa;
}

QPushButton#liveModeButton:checked {
    background-color: #8a592b;
    border-color: #d49a55;
    color: #fff4e8;
}

QPushButton#stopButton {
    background-color: #303841;
    border-color: #65717d;
    color: #e2e7eb;
}

QPushButton#stopButton:hover {
    background-color: #3a444e;
    border-color: #8995a0;
}

QPushButton#disableButton {
    background-color: #7e3034;
    border-color: #bd5055;
    color: #fff1f1;
}

QPushButton#disableButton:hover {
    background-color: #943a3f;
    border-color: #db6268;
}

QDoubleSpinBox,
QSpinBox {
    min-height: 30px;
    padding: 0 8px;
    background-color: #14191f;
    border: 1px solid #3a4652;
    border-radius: 3px;
    color: #e7edf2;
    font-family: "DejaVu Sans Mono";
}

QDoubleSpinBox:focus,
QSpinBox:focus {
    border-color: #4c91b8;
}

QDoubleSpinBox:disabled,
QSpinBox:disabled {
    color: #5b6671;
    border-color: #2b333c;
}

QSlider::groove:horizontal {
    height: 4px;
    border-radius: 2px;
    background-color: #36414c;
}

QSlider::sub-page:horizontal {
    background-color: #447e9d;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 14px;
    margin: -6px 0;
    border-radius: 7px;
    background-color: #b8c5cf;
    border: 1px solid #d4dde4;
}

QSlider:disabled {
    background-color: transparent;
}

QTextEdit#logView {
    background-color: #11161b;
    border: 1px solid #2d3741;
    border-radius: 4px;
    padding: 8px;
    font-family: "DejaVu Sans Mono";
    font-size: 9pt;
    selection-background-color: #315f78;
}

QSplitter::handle {
    background-color: transparent;
    width: 12px;
}

QScrollBar:vertical {
    width: 10px;
    background-color: #151a20;
}

QScrollBar::handle:vertical {
    min-height: 24px;
    border-radius: 4px;
    background-color: #3b4651;
}

QToolTip {
    background-color: #252d36;
    border: 1px solid #46525f;
    color: #e0e7ec;
}
